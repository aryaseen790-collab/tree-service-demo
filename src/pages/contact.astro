---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import QuoteForm from '../components/QuoteForm.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Icon from '../components/Icon.astro';
import Field from '../components/Field.astro';
import { biz, cityState, telHref, fullAddress, url } from '../lib/site';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact & Free Quote', href: '/contact/' }];
---
<BaseLayout
  title={`Free Tree Service Quote in ${cityState} | ${biz.name}`}
  description={`Get a free tree removal, trimming or stump grinding quote in ${cityState}. Call ${biz.phone.display} or send photos with our quick form.`}
  crumbs={crumbs}
>
  <PageHeader h1="Get a Free Quote" intro="Call, or send the form with a photo of your tree. We'll get back to you quickly with next steps." crumbs={crumbs} ctas={false} />

  <section class="py-12 lg:py-16">
    <div class="container-x grid items-start gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
      <div id="quote">
        <QuoteForm id="contact-quote" variant="full" heading="Tell us about your trees" sub="Fields marked * are required. Everything else is optional." />
      </div>

      <div class="space-y-6">
        <div class="rounded-2xl bg-forest-900 p-6 text-white">
          <p class="font-heading text-xl font-extrabold">Call us</p>
          <a href={telHref} class="mt-2 inline-flex items-center gap-2 font-heading text-3xl font-extrabold text-accent-400 no-underline hover:text-accent-300"><Icon name="phone" class="h-7 w-7" />{biz.phone.display}</a>
          <p class="mt-3 text-cream-200">We respond within <Field v={biz.responseTime} />.</p>
          <p class="mt-1 text-cream-200">Storm emergency? <a href={url('/emergency-tree-service/')} class="font-bold text-white underline underline-offset-4">Get urgent help</a>.</p>
        </div>

        <dl class="grid gap-4 rounded-2xl bg-white p-6 ring-1 ring-forest-900/10">
          <div class="flex gap-3">
            <Icon name="pin" class="mt-1 h-5 w-5 shrink-0 text-forest-600" />
            <div><dt class="font-bold text-forest-950">Address</dt><dd>{fullAddress}</dd></div>
          </div>
          <div class="flex gap-3">
            <Icon name="clock" class="mt-1 h-5 w-5 shrink-0 text-forest-600" />
            <div><dt class="font-bold text-forest-950">Hours</dt><dd><Field v={biz.hours.display} /></dd></div>
          </div>
          <div class="flex gap-3">
            <Icon name="mail" class="mt-1 h-5 w-5 shrink-0 text-forest-600" />
            <div><dt class="font-bold text-forest-950">Email</dt><dd><Field v={biz.email} /></dd></div>
          </div>
          <div class="flex gap-3">
            <Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-forest-600" />
            <div><dt class="font-bold text-forest-950">Service area</dt><dd>{biz.serviceArea.join(', ')}</dd></div>
          </div>
        </dl>

        <MapEmbed />
      </div>
    </div>
  </section>
</BaseLayout>
