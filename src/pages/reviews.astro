---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ReviewsGrid from '../components/ReviewsGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import Stars from '../components/Stars.astro';
import Icon from '../components/Icon.astro';
import { biz, cityState } from '../lib/site';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Reviews', href: '/reviews/' }];
---
<BaseLayout
  title={`Reviews | ${biz.name}, ${cityState}`}
  description={`${biz.name} is rated ${biz.rating.value.toFixed(1)} stars from ${biz.rating.count} Google reviews. See what ${biz.address.city}-area homeowners say about our tree work.`}
  crumbs={crumbs}
>
  <PageHeader h1={`${biz.name} Reviews`} intro={`Rated ${biz.rating.value.toFixed(1)} out of 5 by ${biz.rating.count} customers on Google.`} crumbs={crumbs} image="service-trimming" ctas={false} />

  <section class="py-14 lg:py-20">
    <div class="container-x">
      <div class="flex flex-col items-start gap-6 rounded-2xl bg-white p-6 ring-1 ring-forest-900/10 sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <div class="flex items-center gap-5">
          <p class="font-heading text-6xl font-extrabold text-forest-950">{biz.rating.value.toFixed(1)}</p>
          <div>
            <Stars value={biz.rating.value} class="h-6 w-6" label={`${biz.rating.value} out of 5 stars`} />
            <p class="mt-1 font-semibold text-forest-950">{biz.rating.count} reviews on {biz.rating.source}</p>
          </div>
        </div>
        <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
          <a href={biz.links.googleProfile} class="btn-outline" rel="noopener" target="_blank">See all on Google<span class="sr-only"> (opens in a new tab)</span></a>
          <a href={biz.links.googleReview} class="btn-accent" rel="noopener" target="_blank"><Icon name="star" /> Leave us a review<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </div>
      {biz.links.googleReviewIsPlaceholder && <p class="mt-3 text-sm text-muted"><span class="confirm">[CONFIRM: direct Google review link from the Google Business Profile]</span></p>}

      <h2 class="mt-14 text-3xl font-extrabold">What customers say</h2>
      <p class="mt-2 text-muted">Real reviews, copied word for word from Google.</p>
      <div class="mt-8"><ReviewsGrid limit={12} placeholders={6} /></div>
    </div>
  </section>

  <CtaBand heading="Join our happy customers" />
</BaseLayout>
