---
// The owner's logo tree (from brand/logo-source.webp via scripts/make-brand.mjs) + wordmark.
import { biz, url } from '../lib/site';
interface Props { size?: 'sm' | 'lg'; class?: string }
const { size = 'sm', class: cls = '' } = Astro.props;
---
<a href={url('/')} class={`group flex items-center gap-2.5 no-underline ${cls}`} aria-label={`${biz.name} home`}>
  <img
    src={url('/images/brand/logo-tree-160.webp')}
    srcset={`${url('/images/brand/logo-tree-160.webp')} 160w, ${url('/images/brand/logo-tree-320.webp')} 320w`}
    sizes={size === 'lg' ? '120px' : '72px'}
    alt=""
    width="160"
    height="89"
    class={`${size === 'lg' ? 'w-28' : 'w-14 lg:w-[4.5rem]'} h-auto origin-bottom transition-transform duration-500 group-hover:rotate-[-2deg] group-hover:scale-105`}
  />
  <span class="flex flex-col leading-none">
    <span class={`text-gold font-heading font-extrabold uppercase tracking-tight ${size === 'lg' ? 'text-3xl' : 'text-lg lg:text-xl'}`} style="font-stretch: condensed;">{biz.name}</span>
    <span class="mt-1 text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-cream-300/80">{biz.address.city}, {biz.address.state}</span>
  </span>
</a>
