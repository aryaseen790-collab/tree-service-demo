---
// Stylized service-area map: towns placed by their real (approximate) coordinates,
// routes draw out from the home base, pins pop in, the base pulses. Not to scale.
import { biz, serviceArea, areaSlug, url } from '../lib/site';
import { cityCoords } from '../data/geo';

interface Props { highlight?: string }
const { highlight } = Astro.props;

const W = 680, H = 470, PAD = 90;
const pts = serviceArea.map((c) => ({ city: c, ...cityCoords[c] })).filter((p) => p.lat);
const lons = pts.map((p) => p.lon), lats = pts.map((p) => p.lat);
const [minLon, maxLon, minLat, maxLat] = [Math.min(...lons), Math.max(...lons), Math.min(...lats), Math.max(...lats)];
const kx = Math.cos(((minLat + maxLat) / 2) * (Math.PI / 180));
const scale = Math.min((W - PAD * 2) / ((maxLon - minLon) * kx), (H - PAD * 2) / (maxLat - minLat));
const project = (lat: number, lon: number) => ({
  x: PAD + (lon - minLon) * kx * scale + ((W - PAD * 2) - (maxLon - minLon) * kx * scale) / 2,
  y: PAD + (maxLat - lat) * scale + ((H - PAD * 2) - (maxLat - minLat) * scale) / 2,
});
const base = pts.find((p) => p.city === biz.address.city) ?? pts[0];
const b = project(base.lat, base.lon);
const towns = pts.map((p) => ({ ...p, ...project(p.lat, p.lon) }));

// Optional landmarks for context (approximate).
const lakes = [
  { name: 'Lake Belton', lat: 31.135, lon: -97.48, rx: 34, ry: 15, rot: -35 },
  { name: 'Stillhouse Hollow', lat: 31.03, lon: -97.56, rx: 30, ry: 10, rot: -15 },
].map((l) => ({ ...l, ...project(l.lat, l.lon) }));
const i35 = [[30.9, -97.55], [30.95, -97.535], [31.06, -97.47], [31.1, -97.355], [31.2, -97.3], [31.26, -97.27]].map(([la, lo]) => project(la, lo));
const i35Path = 'M' + i35.map((p) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' L');
---
<figure class="relative overflow-hidden rounded-3xl bg-ink-950 p-3 shadow-2xl ring-1 ring-accent-500/30" data-animate>
  <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-labelledby="map-title map-desc">
    <title id="map-title">{biz.name} service area map</title>
    <desc id="map-desc">Based in {biz.address.city}. Serving {serviceArea.join(', ')}.</desc>
    <defs>
      <radialGradient id="mapglow"><stop offset="0" stop-color="#d4a72c" stop-opacity=".35" /><stop offset="1" stop-color="#d4a72c" stop-opacity="0" /></radialGradient>
      <pattern id="mapgrid" width="34" height="34" patternUnits="userSpaceOnUse"><path d="M34 0H0V34" fill="none" stroke="rgba(240,214,138,.07)" stroke-width="1" /></pattern>
    </defs>
    <rect width={W} height={H} fill="url(#mapgrid)" />
    <circle cx={b.x} cy={b.y} r="220" fill="url(#mapglow)" />
    {lakes.map((l) => (
      <g>
        <ellipse cx={l.x} cy={l.y} rx={l.rx} ry={l.ry} transform={`rotate(${l.rot} ${l.x} ${l.y})`} fill="#1e4b5f" opacity=".75" />
        <text x={l.x} y={l.y + l.ry + 16} text-anchor="middle" font-size="11" fill="#8fb3c4" font-family="Inter, sans-serif">{l.name}</text>
      </g>
    ))}
    <path d={i35Path} fill="none" stroke="rgba(250,247,240,.25)" stroke-width="5" stroke-linecap="round" />
    <path d={i35Path} fill="none" stroke="rgba(10,15,12,.9)" stroke-width="1.5" stroke-dasharray="6 6" />
    <text x={i35[4].x + 10} y={i35[4].y + 4} font-size="12" font-weight="700" fill="rgba(250,247,240,.55)" font-family="Inter, sans-serif">I-35</text>

    {towns.filter((t) => t.city !== base.city).map((t, i) => {
      const len = Math.hypot(t.x - b.x, t.y - b.y);
      return <line x1={b.x} y1={b.y} x2={t.x} y2={t.y} stroke="#d4a72c" stroke-width="2" stroke-linecap="round" opacity=".8" data-draw style={`--len:${len.toFixed(0)};--d:${200 + i * 150}ms`} />;
    })}

    <circle cx={b.x} cy={b.y} r="10" fill="none" stroke="#f0d68a" stroke-width="2" class="animate-ping-slow" style={`transform-origin:${b.x}px ${b.y}px`} />
    {towns.map((t, i) => {
      const isBase = t.city === base.city;
      const isHi = t.city === highlight;
      // Label side: right by default, left near the east edge, or as set in data/geo.ts.
      const side = t.label ?? (isBase ? 'right' : t.x > W * 0.75 ? 'left' : 'right');
      const lx = side === 'right' ? t.x + 14 : side === 'left' ? t.x - 14 : t.x;
      const ly = side === 'below' ? t.y + 26 : t.y + 5;
      const anchor = side === 'right' ? 'start' : side === 'left' ? 'end' : 'middle';
      return (
        <a href={url(`/${areaSlug(t.city)}/`)} aria-label={`Tree service in ${t.city}`}>
          <g data-pop style={`--d:${600 + i * 120}ms;transform-origin:${t.x}px ${t.y}px`} class="cursor-pointer">
            <circle cx={t.x} cy={t.y} r={isBase ? 11 : isHi ? 9 : 7} fill={isBase || isHi ? '#f0d68a' : '#d4a72c'} stroke="#0a0f0c" stroke-width="3" />
            <text x={lx} y={ly} text-anchor={anchor} font-size={isBase ? 17 : 15} font-weight="800" fill={isHi ? '#f0d68a' : '#faf7f0'} font-family="Archivo, Inter, sans-serif" paint-order="stroke" stroke="#0a0f0c" stroke-width="4">{t.city}</text>
            {isBase && <text x={t.x + 14} y={t.y + 22} font-size="11" font-weight="700" fill="#d4a72c" font-family="Inter, sans-serif" letter-spacing="1.5">HOME BASE</text>}
          </g>
        </a>
      );
    })}
  </svg>
  <figcaption class="px-3 pb-1 pt-2 text-xs text-cream-300/80">Approximate locations, not to scale. Tap a town to see local tree info.</figcaption>
</figure>
