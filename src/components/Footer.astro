---
import { biz, services, serviceArea, telHref, url, fullAddress, areaSlug, costGuidePath, DEMO_MODE } from '../lib/site';
import Field from './Field.astro';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="bg-forest-950 text-cream-200">
  <div class="container-x grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-heading text-xl font-extrabold text-white">{biz.name}</p>
      <p class="mt-3 text-cream-200">{biz.tagline}.</p>
      <a href={telHref} class="mt-4 inline-flex items-center gap-2 font-heading text-xl font-extrabold text-accent-400 no-underline hover:text-accent-300"><Icon name="phone" />{biz.phone.display}</a>
      <p class="mt-3 flex gap-2"><Icon name="pin" class="mt-1 h-5 w-5 shrink-0" /><span>{fullAddress}</span></p>
      <p class="mt-2 flex gap-2"><Icon name="clock" class="mt-1 h-5 w-5 shrink-0" /><span><Field v={biz.hours.display} /></span></p>
    </div>
    <div>
      <h2 class="font-heading text-base font-bold uppercase tracking-wider text-white">Services</h2>
      <ul class="mt-4 space-y-2">
        {services.map((s) => <li><a href={url(`/${s.slug}/`)} class="text-cream-200 no-underline hover:text-white hover:underline">{s.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="font-heading text-base font-bold uppercase tracking-wider text-white">Areas We Serve</h2>
      <ul class="mt-4 space-y-2">
        {serviceArea.map((c) => <li><a href={url(`/${areaSlug(c)}/`)} class="text-cream-200 no-underline hover:text-white hover:underline">Tree Service in {c}</a></li>)}
        <li><a href={url('/service-areas/')} class="text-cream-200 no-underline hover:text-white hover:underline">All service areas</a></li>
      </ul>
    </div>
    <div>
      <h2 class="font-heading text-base font-bold uppercase tracking-wider text-white">Company</h2>
      <ul class="mt-4 space-y-2">
        <li><a href={url('/about/')} class="text-cream-200 no-underline hover:text-white hover:underline">About Us</a></li>
        <li><a href={url('/reviews/')} class="text-cream-200 no-underline hover:text-white hover:underline">Reviews</a></li>
        <li><a href={url(costGuidePath)} class="text-cream-200 no-underline hover:text-white hover:underline">Tree Removal Cost Guide</a></li>
        <li><a href={url('/contact/')} class="text-cream-200 no-underline hover:text-white hover:underline">Contact &amp; Free Quote</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-sm text-cream-300 sm:flex-row sm:justify-between">
      <p>© {year} {biz.name}. All rights reserved.</p>
      {DEMO_MODE && <p>Concept preview, not an official site. No cookies, no tracking.</p>}
    </div>
  </div>
</footer>
