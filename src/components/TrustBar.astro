---
import { biz, isPlaceholder, url } from '../lib/site';
import Stars from './Stars.astro';
import Icon from './Icon.astro';
const licensedText = isPlaceholder(biz.trust.licensed) || isPlaceholder(biz.trust.insured)
  ? '[CONFIRM: Licensed & Insured]'
  : 'Licensed & Insured';
---
<section aria-label="Why homeowners trust us" class="border-y border-forest-900/10 bg-white">
  <ul class="container-x grid grid-cols-2 gap-x-4 gap-y-5 py-6 text-sm font-semibold text-forest-950 sm:text-base lg:grid-cols-4">
    <li class="flex items-center gap-3">
      <a href={url('/reviews/')} class="flex items-center gap-3 no-underline hover:underline">
        <span class="flex flex-col">
          <Stars value={biz.rating.value} class="h-4 w-4" />
          <span><strong class="font-extrabold">{biz.rating.value.toFixed(1)}</strong> on Google ({biz.rating.count} reviews)</span>
        </span>
      </a>
    </li>
    <li class="flex items-center gap-3"><Icon name="check" class="h-6 w-6 shrink-0 text-forest-600" /> Free Estimates</li>
    <li class="flex items-center gap-3"><Icon name="clock" class="h-6 w-6 shrink-0 text-forest-600" /> Same-Day Response</li>
    <li class="flex items-center gap-3"><Icon name="shield" class="h-6 w-6 shrink-0 text-forest-600" />
      {isPlaceholder(licensedText) ? <span class="confirm">{licensedText}</span> : licensedText}
    </li>
  </ul>
</section>
