---
import { biz, telHref, url } from '../lib/site';
import Icon from './Icon.astro';
interface Props { heading?: string; text?: string }
const {
  heading = 'Ready for a free, no-pressure quote?',
  text = `Tell us about your trees. We'll come out, take a look and give you a clear price in writing.`,
} = Astro.props;
---
<section class="bg-forest-900 text-white">
  <div class="container-x flex flex-col items-start gap-6 py-12 md:flex-row md:items-center md:justify-between lg:py-16">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-extrabold text-white sm:text-4xl">{heading}</h2>
      <p class="mt-3 text-lg text-cream-200">{text}</p>
    </div>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a href={telHref} class="btn-accent text-lg"><Icon name="phone" /> {biz.phone.display}</a>
      <a href={url('/contact/#quote')} class="btn-ghost-light text-lg">Get a Free Quote</a>
    </div>
  </div>
</section>
