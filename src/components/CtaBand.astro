---
import { biz, telHref, url } from '../lib/site';
import Icon from './Icon.astro';
import Leaves from './Leaves.astro';
interface Props { heading?: string; text?: string }
const {
  heading = 'Ready for a free, no-pressure quote?',
  text = `Tell us about your trees. We'll come out, take a look and give you a clear price in writing.`,
} = Astro.props;
---
<section class="bg-night grain relative isolate overflow-hidden text-white">
  <Leaves count={7} />
  <img src={url('/images/brand/logo-tree-800.webp')} alt="" width="800" height="446" loading="lazy" class="animate-sway pointer-events-none absolute -bottom-10 left-1/2 -z-10 w-[40rem] max-w-none -translate-x-1/2 origin-bottom opacity-10" />
  <div class="container-x relative flex flex-col items-start gap-8 py-16 md:flex-row md:items-center md:justify-between lg:py-20" data-reveal>
    <div class="max-w-2xl">
      <h2 class="text-3xl font-extrabold text-white sm:text-4xl lg:text-5xl">{heading}</h2>
      <p class="mt-4 text-lg text-cream-200">{text}</p>
    </div>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a href={telHref} class="btn-accent text-lg"><Icon name="phone" /> {biz.phone.display}</a>
      <a href={url('/contact/#quote')} class="btn-ghost-light text-lg">Get a Free Quote</a>
    </div>
  </div>
</section>
