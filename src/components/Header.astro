---
import { biz, services, telHref, url, costGuidePath } from '../lib/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const nav = [
  { href: '/emergency-tree-service/', label: 'Emergency' },
  { href: '/service-areas/', label: 'Service Areas' },
  { href: costGuidePath, label: 'Cost Guide' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => path === url(href);
---
<header class="sticky top-0 z-40 border-b border-accent-500/25 bg-ink-950/90 text-cream-100 backdrop-blur-md">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:font-bold focus:text-ink-950">Skip to content</a>
  <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 xl:h-20">
    <Logo />

    <nav class="hidden items-center gap-0.5 text-[0.95rem] xl:flex" aria-label="Main">
      <details class="nav-dd relative">
        <summary class="flex items-center gap-1 rounded-md px-2.5 py-2 font-semibold text-cream-100 transition hover:text-accent-300">
          Services <Icon name="chevron" class="h-4 w-4" />
        </summary>
        <ul class="absolute left-0 top-full mt-3 w-80 rounded-2xl border border-accent-500/20 bg-ink-900/95 p-2 shadow-2xl backdrop-blur">
          {services.map((s) => (
            <li><a href={url(`/${s.slug}/`)} class="flex items-center justify-between rounded-xl px-3 py-2.5 font-medium text-cream-100 no-underline transition hover:bg-white/5 hover:text-accent-300" aria-current={isActive(`/${s.slug}/`) ? 'page' : undefined}>{s.name}<Icon name="arrow" class="h-4 w-4 opacity-50" /></a></li>
          ))}
        </ul>
      </details>
      {nav.map((n) => (
        <a href={url(n.href)} class:list={['relative whitespace-nowrap rounded-md px-2.5 py-2 font-semibold no-underline transition hover:text-accent-300 after:absolute after:inset-x-2.5 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:rounded after:bg-accent-400 after:transition-transform hover:after:scale-x-100', isActive(n.href) ? 'text-accent-300 after:scale-x-100' : 'text-cream-100']} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={telHref} class="hidden items-center gap-2 whitespace-nowrap font-heading text-lg font-extrabold text-accent-300 no-underline transition hover:text-accent-200 md:flex">
        <span class="relative flex h-8 w-8 items-center justify-center rounded-full bg-accent-500/15">
          <span class="absolute inset-0 rounded-full bg-accent-500/30 animate-ping-slow" aria-hidden="true"></span>
          <Icon name="phone" class="relative h-4 w-4" />
        </span>{biz.phone.display}
      </a>
      <a href={url('/contact/#quote')} class="btn-accent hidden min-h-11 py-2 text-sm md:inline-flex">Free Quote</a>

      <details class="nav-dd xl:hidden">
        <summary class="flex h-11 w-11 items-center justify-center rounded-lg border border-accent-500/40 text-accent-300" aria-label="Open menu">
          <Icon name="menu" class="h-6 w-6" />
        </summary>
        <nav class="absolute inset-x-0 top-full max-h-[calc(100vh-4rem)] overflow-y-auto border-b border-accent-500/20 bg-ink-950 px-4 pb-6 pt-2 shadow-2xl" aria-label="Mobile">
          <p class="eyebrow-light mt-3 px-2">Services</p>
          <ul class="mt-1 grid grid-cols-1 gap-0.5 sm:grid-cols-2">
            {services.map((s) => (
              <li><a href={url(`/${s.slug}/`)} class="block rounded-md px-2 py-2.5 font-semibold text-cream-100 no-underline hover:bg-white/5 hover:text-accent-300">{s.name}</a></li>
            ))}
          </ul>
          <hr class="my-3 border-white/10" />
          <ul class="grid grid-cols-1 gap-0.5 sm:grid-cols-2">
            {nav.map((n) => (
              <li><a href={url(n.href)} class="block rounded-md px-2 py-2.5 font-semibold text-cream-100 no-underline hover:bg-white/5 hover:text-accent-300">{n.label}</a></li>
            ))}
            <li><a href={url('/contact/')} class="block rounded-md px-2 py-2.5 font-semibold text-cream-100 no-underline hover:bg-white/5 hover:text-accent-300">Contact</a></li>
          </ul>
          <a href={telHref} class="btn-accent mt-4 w-full"><Icon name="phone" /> Call {biz.phone.display}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Close open menus on outside click or Escape (details/summary handles the rest without JS).
  const menus = document.querySelectorAll<HTMLDetailsElement>('details.nav-dd');
  document.addEventListener('click', (e) => {
    menus.forEach((d) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    menus.forEach((d) => { if (d.open) { d.open = false; d.querySelector('summary')?.focus(); } });
  });
</script>
