---
import { biz, services, telHref, url, costGuidePath } from '../lib/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const nav = [
  { href: '/emergency-tree-service/', label: 'Emergency' },
  { href: '/service-areas/', label: 'Service Areas' },
  { href: costGuidePath, label: 'Cost Guide' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => path === url(href);
---
<header class="sticky top-0 z-40 border-b border-forest-900/10 bg-cream-50/95 backdrop-blur">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:font-bold">Skip to content</a>
  <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 xl:h-20">
    <a href={url('/')} class="flex items-center gap-2.5 no-underline" aria-label={`${biz.name} home`}>
      <img src={url('/favicon.svg')} alt="" width="40" height="40" class="h-9 w-9 lg:h-10 lg:w-10" />
      <span class="whitespace-nowrap font-heading text-lg font-extrabold leading-none text-forest-950 lg:text-xl">{biz.name}</span>
    </a>

    <nav class="hidden items-center gap-0.5 text-[0.95rem] xl:flex" aria-label="Main">
      <details class="nav-dd relative">
        <summary class="flex items-center gap-1 rounded-md px-2.5 py-2 font-semibold text-forest-950 hover:bg-forest-100">
          Services <Icon name="chevron" class="h-4 w-4" />
        </summary>
        <ul class="absolute left-0 top-full mt-2 w-72 rounded-xl border border-forest-900/10 bg-white p-2 shadow-xl">
          {services.map((s) => (
            <li><a href={url(`/${s.slug}/`)} class="block rounded-md px-3 py-2 font-medium text-forest-950 no-underline hover:bg-forest-50" aria-current={isActive(`/${s.slug}/`) ? 'page' : undefined}>{s.name}</a></li>
          ))}
        </ul>
      </details>
      {nav.map((n) => (
        <a href={url(n.href)} class:list={['whitespace-nowrap rounded-md px-2.5 py-2 font-semibold no-underline hover:bg-forest-100', isActive(n.href) ? 'text-forest-700 underline decoration-2 underline-offset-8' : 'text-forest-950']} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={telHref} class="hidden items-center gap-2 whitespace-nowrap font-heading text-lg font-extrabold text-forest-900 no-underline hover:text-forest-700 md:flex">
        <Icon name="phone" class="h-5 w-5 text-accent-600" />{biz.phone.display}
      </a>
      <a href={url('/contact/#quote')} class="btn-accent hidden min-h-11 py-2 text-sm md:inline-flex">Free Quote</a>

      <details class="nav-dd xl:hidden">
        <summary class="flex h-11 w-11 items-center justify-center rounded-lg border border-forest-900/20 text-forest-950" aria-label="Open menu">
          <Icon name="menu" class="h-6 w-6" />
        </summary>
        <nav class="absolute inset-x-0 top-full max-h-[calc(100vh-4rem)] overflow-y-auto border-b border-forest-900/10 bg-cream-50 px-4 pb-6 pt-2 shadow-xl" aria-label="Mobile">
          <p class="eyebrow mt-2 px-2">Services</p>
          <ul class="mt-1 grid grid-cols-1 gap-0.5 sm:grid-cols-2">
            {services.map((s) => (
              <li><a href={url(`/${s.slug}/`)} class="block rounded-md px-2 py-2.5 font-semibold text-forest-950 no-underline hover:bg-forest-100">{s.name}</a></li>
            ))}
          </ul>
          <hr class="my-3 border-forest-900/10" />
          <ul class="grid grid-cols-1 gap-0.5 sm:grid-cols-2">
            {nav.map((n) => (
              <li><a href={url(n.href)} class="block rounded-md px-2 py-2.5 font-semibold text-forest-950 no-underline hover:bg-forest-100">{n.label}</a></li>
            ))}
            <li><a href={url('/contact/')} class="block rounded-md px-2 py-2.5 font-semibold text-forest-950 no-underline hover:bg-forest-100">Contact</a></li>
          </ul>
          <a href={telHref} class="btn-accent mt-4 w-full"><Icon name="phone" /> Call {biz.phone.display}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Close open menus on outside click or Escape (details/summary handles the rest without JS).
  const menus = document.querySelectorAll<HTMLDetailsElement>('details.nav-dd');
  document.addEventListener('click', (e) => {
    menus.forEach((d) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    menus.forEach((d) => { if (d.open) { d.open = false; d.querySelector('summary')?.focus(); } });
  });
</script>
