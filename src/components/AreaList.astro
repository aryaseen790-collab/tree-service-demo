---
import { serviceArea, url, areaSlug } from '../lib/site';
import Icon from './Icon.astro';
interface Props { exclude?: string; dark?: boolean }
const { exclude, dark = false } = Astro.props;
const cities = serviceArea.filter((c) => c !== exclude);
---
<ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
  {cities.map((c) => (
    <li>
      <a href={url(`/${areaSlug(c)}/`)} class:list={['flex items-center gap-2 rounded-xl px-4 py-3 font-semibold no-underline ring-1 transition', dark ? 'bg-white/5 text-white ring-white/20 hover:bg-white/10' : 'bg-white text-forest-950 ring-forest-900/10 hover:ring-forest-600']}>
        <Icon name="pin" class={`h-5 w-5 shrink-0 ${dark ? 'text-accent-400' : 'text-forest-600'}`} />{c}
      </a>
    </li>
  ))}
</ul>
