---
interface Props { faqs: { q: string; a: string }[]; heading?: string; id?: string }
const { faqs, heading = 'Frequently asked questions', id = 'faq' } = Astro.props;
---
<section aria-labelledby={`${id}-h`} class="mt-14">
  <h2 id={`${id}-h`} class="text-2xl font-extrabold sm:text-3xl">{heading}</h2>
  <div class="mt-6 divide-y divide-forest-900/10 rounded-2xl bg-white ring-1 ring-forest-900/10">
    {faqs.map((f) => (
      <details class="group px-5 py-4 open:bg-forest-50/50">
        <summary class="flex items-start justify-between gap-4 font-heading text-lg font-bold text-forest-950">
          <h3 class="text-lg font-bold">{f.q}</h3>
          <span class="mt-1 shrink-0 text-2xl leading-none text-forest-600 transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 text-ink">{f.a}</p>
      </details>
    ))}
  </div>
</section>
