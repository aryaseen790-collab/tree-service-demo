{
  "name": "tree-service-demo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-page local tree service website (Astro + Tailwind). All business details live in src/data/business.json.",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev --force",
    "build": "astro build --force",
    "preview": "astro preview",
    "images": "node scripts/fetch-images.mjs",
    "images:placeholders": "node scripts/make-placeholders.mjs",
    "check:links": "node scripts/check-links.mjs",
    "audit": "node scripts/audit.mjs",
    "test": "npm run build && node scripts/audit.mjs && node scripts/check-links.mjs",
    "brand": "node scripts/make-brand.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
